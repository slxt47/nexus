# Kopieren nach .env und bei Bedarf anpassen

# --- Datenbank ---
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_pw

# --- Auth ---
# WICHTIG: In Produktion mit `openssl rand -hex 32` neu generieren
JWT_SECRET=please_change_me_in_production_32_chars_min

# --- Owner-Account (wird beim ersten Start automatisch angelegt) ---
OWNER_EMAIL=owner@example.org
OWNER_USERNAME=admin
OWNER_DISPLAY_NAME=SYSTEM

# --- E-Mail (Login-Codes) ---
# Standard: der Mail-Fänger im Compose-Stack (Weboberfläche http://localhost:8025)
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=NEXUS <nexus@localhost>
# Für echten Versand z. B.:
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
